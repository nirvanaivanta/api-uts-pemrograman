                  "pm.test(\"harga berubah\", () => pm.expect(json.data.harga).to.eql(75000));",
                  "pm.test(\"stok berubah\", () => pm.expect(json.data.stok).to.eql(20));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kategori_id\": {{kategoriId}},\n  \"kode_produk\": \"PRD-PUT-{{$timestamp}}\",\n  \"nama_produk\": \"Produk Diupdate\",\n  \"harga\": 75000,\n  \"stok\": 20\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/produk/{{produkId}}", "host": ["{{baseUrl}}"], "path": ["api", "produk", "{{produkId}}"] }
          }
