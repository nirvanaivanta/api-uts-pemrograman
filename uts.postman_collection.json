  "item": [
    {
      "name": "1-Alur Utama",
      "item": [
        {
          "name": "S01 - POST Kategori Baru",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test(\"Ada data.id\", () => pm.expect(json.data.id).to.be.a('number'));",
                  "pm.test(\"Status success\", () => pm.expect(json.status).to.eql('success'));",
                  "pm.environment.set(\"kategoriId\", json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama_kategori\": \"Kategori {{$timestamp}}\",\n  \"deskripsi\": \"Deskripsi test\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/kategori", "host": ["{{baseUrl}}"], "path": ["api", "kategori"] }
          }
        },
        {
          "name": "S02 - POST Produk Baru",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test(\"deleted_at adalah null\", () => pm.expect(json.data.deleted_at).to.be.null);",
                  "pm.test(\"Status success\", () => pm.expect(json.status).to.eql('success'));",
                  "pm.environment.set(\"produkId\", json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kategori_id\": {{kategoriId}},\n  \"kode_produk\": \"PRD-{{$timestamp}}\",\n  \"nama_produk\": \"Produk Test\",\n  \"harga\": 50000,\n  \"stok\": 10\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/produk", "host": ["{{baseUrl}}"], "path": ["api", "produk"] }
          }
        },
        {
          "name": "S03 - GET Produk by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Id sesuai\", () => pm.expect(json.data.id).to.eql(pm.environment.get('produkId') * 1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/produk/{{produkId}}", "host": ["{{baseUrl}}"], "path": ["api", "produk", "{{produkId}}"] }
          }
        },
        {
          "name": "S04 - GET Produk by Kategori",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"count minimal 1\", () => pm.expect(json.count).to.be.at.least(1));",
                  "pm.test(\"Memuat produk S02\", () => {",
                  "  const ids = json.data.map(p => p.id);",
                  "  pm.expect(ids).to.include(pm.environment.get('produkId') * 1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/kategori/{{kategoriId}}/produk", "host": ["{{baseUrl}}"], "path": ["api", "kategori", "{{kategoriId}}", "produk"] }
          }
        },
        {
